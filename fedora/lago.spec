# Generated by porting/scripts/gen-fedora-packaging.py from lago/debian/. Do not edit by hand.
Name:           lago
Version:        0.2.0
Release:        3%{?dist}
Summary:        command-line client for the Rofication notification daemon
License:        Apache-2.0
URL:            https://github.com/regolith-linux/lago
Source0:        %{name}-%{version}.tar.gz

BuildRequires:  make
BuildRequires:  meson
BuildRequires:  gcc
BuildRequires:  vala
BuildRequires:  pkgconfig(glib-2.0)
BuildRequires:  pkgconfig(json-glib-1.0)


%description
Lists and dismisses desktop notifications held by rofication-daemon
(regolith-rofication) from the terminal.

%prep
%autosetup -n %{name}-%{version}

%build
%set_build_flags
%make_build -f fedora/Makefile build MESON_FLAGS="--buildtype=plain"

%install
%make_install -f fedora/Makefile PREFIX=%{_prefix} LIBDIR=%{_libdir} SYSCONFDIR=%{_sysconfdir}
# single-binary compiled package: own everything the build installed
(cd %{buildroot} && find . \( -type f -o -type l \) | sed 's|^\.||' \
   | sed -E 's|^(/usr/lib/python3[^/]*/site-packages/[^/]+)/.*|\1|; s|^(/usr/share/man/.*)$|\1*|' \
   | sort -u | sed -E 's|^(/etc/.*)$|%config(noreplace) \1|') > lago.files

%files -f lago.files

